SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — works with either a local PostgreSQL server (pgAdmin etc.), a
# managed cloud provider (Neon, RDS, ...), or SQLite — just swap DATABASE_URL
# and DB_SSL_MODE below.
#
# Local PostgreSQL (pgAdmin / local server) — these almost never have SSL
# configured, so disable it:
# DATABASE_URL=postgresql://user:password@localhost:5432/hrms_db
# DB_SSL_MODE=disable
#
# Cloud PostgreSQL (Neon, etc.) — SSL is required and is the default below,
# so DB_SSL_MODE can be omitted:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60
DB_SSL_MODE=require

# Redis — required for throttling and caching
REDIS_URL=redis://127.0.0.1:6379/1

# ImageKit — required for all FileField/ImageField uploads (see core/storage.py)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Email (use SMTP credentials)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Aira HRMS <your-email@gmail.com>

# CORS — comma-separated list; add the production frontend domain here (e.g. https://airahrms.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF — comma-separated list; required for Django admin form submissions in production
CSRF_TRUSTED_ORIGINS=https://airahrms.com

# Sarvam AI — voice_commands LLM fallback (sarvam-105b) + Hindi STT (Saaras).
# Server-side only — never prefix with NEXT_PUBLIC_, never expose to the frontend.
# Leave blank to disable both features (they fail soft, see apps/voice_commands/sarvam_client.py).
SARVAM_API_KEY=your-sarvam-api-key-here


# Field-level encryption for sensitive PII (bank account/IFSC, PAN, UAN, ESI,
# Aadhaar-registered name — see core/encrypted_fields.py). The app will not
# start with the placeholder values below — generate real ones per
# environment and never reuse the same pair across dev/staging/production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
# Back these up somewhere safe outside this file (a password manager/secrets
# vault) — losing FIELD_ENCRYPTION_KEY makes every encrypted record in the
# database permanently unrecoverable, with no way to regenerate it.
FIELD_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key-for-this-environment
FIELD_INDEX_HMAC_KEY=changeme-generate-a-real-random-hex-key-for-this-environment


